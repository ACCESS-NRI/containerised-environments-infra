#%Module1.0

# The double underscore variables within this file are replaced by the 'replace_dunder_variables'
# function within the build.sh or deploy.sh scripts

# Prepend environment bin directory (where all launcher symlinks are located) to PATH
prepend-path PATH "__ENV_BIN_DIR__"

# The following environment variables are also set in the internal environment activation script, but
# we set them here as well so they can be also used outside of the internal environment 
# (e.g., to change the PS1 after the module is loaded)
setenv CONDA_PROMPT_MODIFIER "__ENV_PROMPT_MODIFIER__"
setenv CONDA_PREFIX "__INTERNAL_ENV_DIR__"

# Load singularity
module load singularity