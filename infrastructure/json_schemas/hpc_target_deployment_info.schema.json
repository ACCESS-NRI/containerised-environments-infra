{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hpc_target_deployment_info.schema.json",
  "type": "object",
  "required": ["name", "deployments"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the HPC target for the deployment (e.g. Gadi, Setonix)"
    },
    "deployments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
            "module_name",
            "module_version",
            "module_type",
            "deployment_stage",
            "started_at",
            "success"
        ],
        "additionalProperties": true,
        "properties": {
          "module_name": { 
            "type": "string", 
            "minLength": 1,
            "description": "Name of the deployed module"
          },
          "module_version": { 
            "type": "string", 
            "minLength": 1,
            "description": "Version of the deployed module"
          },
          "module_type": {
            "type": "string",
            "enum": ["DEVELOPMENT", "STABLE"],
            "description": "Type of the deployed module. DEVELOPMENT modules are for testing and may be unstable, while STABLE modules are production-ready."
          },
          "deployment_stage": {
            "type": "string",
            "enum": ["STAGING", "PRODUCTION"],
            "description": "Deployment stage of the deployed module. STAGING modules are deployed in a staging folder for testing before being deployed to PRODUCTION."
          },
          "module_usage_instructions": {
            "type": "string",
            "description": "Instructions for using the deployed module"
          },
          "files_manifest": {
            "type": "string",
            "description": "Manifest of files and folders included in the deployment"
          },
          "started_at": {
            "type": "string", "minLength": 1,
            "description": "Timestamp when the deployment was started"
          },
          "completed_at": {
            "type": "string",
            "description": "Timestamp when the deployment was completed"
          },
          "success": {
            "type": "string",
            "enum": ["true", "false", ""],
            "description": "Indicates whether the deployment was successful"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "success": { "const": "true" }
              },
              "required": ["success"]
            },
            "then": {
              "required": [
                "module_usage_instructions",
                "files_manifest",
                "completed_at"
              ]
            }
          }
        ]
      }
    }
  }
}